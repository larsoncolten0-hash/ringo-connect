# Supabase project settings (Project Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used in server-side admin actions (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fapshi (Cameroon mobile money — MTN MoMo / Orange Money)
# Get these from your Fapshi dashboard. Use the sandbox keys/URL while
# testing, switch both to live when you're ready to accept real payments.
FAPSHI_API_USER=your-fapshi-api-user
FAPSHI_API_KEY=your-fapshi-api-key
FAPSHI_BASE_URL=https://sandbox.fapshi.com

# Optional — a separate Fapshi "service" used only to send money out
# (affiliate payouts), since Fapshi issues distinct credentials per
# service. Only used as an env-var fallback; normally set from the admin
# Settings page instead. Falls back to FAPSHI_API_USER/KEY above when unset.
FAPSHI_PAYOUT_API_USER=your-fapshi-payout-api-user
FAPSHI_PAYOUT_API_KEY=your-fapshi-payout-api-key

# Stripe (everywhere else — card payments)
# Secret key and webhook signing secret from the Stripe dashboard.
# STRIPE_PRICE_PRO / STRIPE_PRICE_BUSINESS are Price IDs (price_...) —
# create a recurring monthly Price per plan in Stripe's Product catalog.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_PRO=price_your-pro-plan-price-id
STRIPE_PRICE_BUSINESS=price_your-business-plan-price-id

# Secures the daily plan-expiry cron job (src/app/api/cron/downgrade-expired).
# Set this to a long random string, then add the SAME value in your Vercel
# project settings under Environment Variables — Vercel automatically sends
# it as a Bearer token when it triggers the scheduled job (see vercel.json).
CRON_SECRET=b8687b25e4a68c12faf78671695d929daea797ed8cc1afbafeac4c8cf7a4de4a

# Encrypts secrets stored in the database: payment provider API keys
# (admin Settings page) AND, per-creator, Meta Conversions API / TikTok
# Events API access tokens (Editor → Tracking pixels). Generate with:
# openssl rand -base64 32
# Only needed the moment someone actually saves one of those secrets —
# safe to leave blank until then.
SETTINGS_ENCRYPTION_KEY=generate-with-openssl-rand--base64-32

# Web Push (admin notifications: new signups, subscription payments,
# payout requests — see src/lib/push/send.ts) and, later, any other
# installed-app push notification. Generate a pair with:
# npx web-push generate-vapid-keys
# The public key is safe to expose to the browser (NEXT_PUBLIC_...); the
# private key must never be. Safe to leave both blank until then — every
# notification send just silently no-ops (see isPushConfigured()).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@ringoconnectltd.com

# Resend (https://resend.com) — the one email provider for every Ringo
# Connect email: order/ticket/booking receipts, admin "new signup"/
# payment alerts, the "you're approved" welcome email, and Community
# announcements. See src/lib/email/provider.ts.
#
# RESEND_API_KEY       — from your Resend dashboard (API Keys). Free tier
#                         is generous for getting started.
# RESEND_FROM_EMAIL     — a sender address on a domain you've verified
#                         with Resend (Domains — SPF + DKIM), e.g.
#                         "notifications@yourdomain.com". Never a Resend
#                         sandbox address (onboarding@resend.dev): a real
#                         signup/payment/order email needs to actually
#                         reach the customer's inbox, which a sandbox
#                         sender on a live Resend account generally can't.
#
# Until BOTH are set, sendEmail() sends nothing at all and reports back
# "provider_not_configured" — there is no sandbox fallback to silently
# fall back to, so a missing/misconfigured value fails loudly instead of
# quietly mis-delivering.
#
# COMMUNITY_EMAIL_FROM is accepted as a legacy alias for RESEND_FROM_EMAIL
# (some earlier deployments set only this one) — new setups only need
# RESEND_FROM_EMAIL.
#
# One address for everything today. If you later want separate senders
# per email category (e.g. notifications@/billing@/support@/updates@,
# all on the same verified domain), that's a straightforward follow-up —
# it isn't implemented yet, so don't set additional FROM variables
# expecting them to be read; only RESEND_FROM_EMAIL/COMMUNITY_EMAIL_FROM
# are currently recognized.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=notifications@yourdomain.com

# Optional — verifies Resend's delivery-event webhook (email.delivered/
# bounced/complained/failed — see src/app/api/email/webhook/route.ts),
# which updates email_delivery_logs and the bounce/complaint suppression
# list. Get this from the Resend dashboard after creating the webhook
# endpoint (Webhooks → Add Endpoint → point it at
# https://yourdomain.com/api/email/webhook → copy the Signing Secret).
# Leaving this unset doesn't stop email sending — it just means the
# webhook route refuses every request (503) since there'd be nothing to
# verify signatures against, and delivery logs never advance past "sent".
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-signing-secret

# Ringo Loyalty -- server-only key that derives each customer's QR code (see
# src/lib/loyalty/qrCrypto.ts). Required for My QR and Scan Customer; without it those
# features fail closed. Use a long random value (32+ characters), e.g.
#   openssl rand -base64 48
# Keep it secret and never change it casually: after a change every customer's QR is
# re-issued the next time they open My QR, and any QR shown or printed before the
# change stops working.
LOYALTY_QR_SECRET=replace-with-a-long-random-secret

# Ringo AI (owner-only beta — see src/lib/ai/ and /admin/ai)
# Server-only Anthropic API key used by src/lib/ai/providers/anthropic.ts.
# Never prefix it with NEXT_PUBLIC_. While unset, Ringo AI stays unavailable
# (the launcher never appears) even if it's enabled in /admin/ai. The model,
# limits, budget and kill switch live in the ai_settings table, not here.
ANTHROPIC_API_KEY=your-anthropic-api-key
