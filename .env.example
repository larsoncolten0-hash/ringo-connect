# Supabase project settings (Project Settings > API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used in server-side admin actions (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fapshi (Cameroon mobile money — MTN MoMo / Orange Money)
# Get these from your Fapshi dashboard. Use the sandbox keys/URL while
# testing, switch both to live when you're ready to accept real payments.
FAPSHI_API_USER=your-fapshi-api-user
FAPSHI_API_KEY=your-fapshi-api-key
FAPSHI_BASE_URL=https://sandbox.fapshi.com

# Optional — a separate Fapshi "service" used only to send money out
# (affiliate payouts), since Fapshi issues distinct credentials per
# service. Only used as an env-var fallback; normally set from the admin
# Settings page instead. Falls back to FAPSHI_API_USER/KEY above when unset.
FAPSHI_PAYOUT_API_USER=your-fapshi-payout-api-user
FAPSHI_PAYOUT_API_KEY=your-fapshi-payout-api-key

# Stripe (everywhere else — card payments)
# Secret key and webhook signing secret from the Stripe dashboard.
# STRIPE_PRICE_PRO / STRIPE_PRICE_BUSINESS are Price IDs (price_...) —
# create a recurring monthly Price per plan in Stripe's Product catalog.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PRICE_PRO=price_your-pro-plan-price-id
STRIPE_PRICE_BUSINESS=price_your-business-plan-price-id

# Secures the daily plan-expiry cron job (src/app/api/cron/downgrade-expired).
# Set this to a long random string, then add the SAME value in your Vercel
# project settings under Environment Variables — Vercel automatically sends
# it as a Bearer token when it triggers the scheduled job (see vercel.json).
CRON_SECRET=b8687b25e4a68c12faf78671695d929daea797ed8cc1afbafeac4c8cf7a4de4a

# Resend (transactional email — signup confirmations, admin/super-creator
# "new signup" alerts, and the "you're approved" email once a request is
# turned into an account). Get an API key at resend.com; RESEND_FROM_EMAIL
# needs a domain verified in Resend or you can leave it as the sandbox
# default below for testing. Leaving RESEND_API_KEY unset just skips
# sending — nothing else breaks (see src/lib/email.ts).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Encrypts secrets stored in the database: payment provider API keys
# (admin Settings page) AND, per-creator, Meta Conversions API / TikTok
# Events API access tokens (Editor → Tracking pixels). Generate with:
# openssl rand -base64 32
# Only needed the moment someone actually saves one of those secrets —
# safe to leave blank until then.
SETTINGS_ENCRYPTION_KEY=generate-with-openssl-rand--base64-32
 